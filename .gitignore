# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj

# ...but a Wavefront .obj is geometry, not a compiler artifact, and the two
# share an extension. Scene models are content and must be tracked, or a fresh
# clone loses the import fixtures and tests/test_scene.c fails for everyone but
# the person who created them. Compiler output goes to /build/ anyway.
!scenes/**/*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# Build artifacts (anchored to the repo root: a bare `lightsim` would also
# match the include/lightsim/ header directory)
/build/
/lightsim
/lightsim-view
/run_tests

# Reference papers: 75 MB of PDFs, two of them unrelated textbooks. Kept out of
# git history deliberately -- drop this line if they should be tracked.
/papers/

/build/

# Simulation outputs
/out/

# Python bytecode from tools/
__pycache__/
*.pyc
