# A work surface lit by a 2x2 array of LED panels inside a white enclosure.
# Demonstrates the three things the closed-form cos(theta)/r^2 model cannot do:
# shadowing, interreflection off the enclosure, and a real spectral source.

material floor  lambert 0.20
material wall   lambert 0.80
material part   lambert 0.50

# Enclosure, 0.6 x 0.6 x 0.5 m, open toward -y so the camera can see in.
quad floor  0     0     0.0    0  0  1    0.3 0 0     0 0.3 0
quad wall   0     0     0.5    0  0 -1    0.3 0 0     0 0.3 0
quad wall  -0.3   0     0.25   1  0  0    0 0.3 0     0 0 0.25
quad wall   0.3   0     0.25  -1  0  0    0 0.3 0     0 0 0.25
quad wall   0     0.3   0.25   0 -1  0    0.3 0 0     0 0 0.25

# 2x2 array of 200 lm neutral-white panels facing down (ey negated so n = -z).
light rect -0.12 -0.12 0.45   0.05 0 0   0 -0.05 0   lm 200 daylight 5000
light rect  0.12 -0.12 0.45   0.05 0 0   0 -0.05 0   lm 200 daylight 5000
light rect -0.12  0.12 0.45   0.05 0 0   0 -0.05 0   lm 200 daylight 5000
light rect  0.12  0.12 0.45   0.05 0 0   0 -0.05 0   lm 200 daylight 5000

# A part held above the surface, casting a soft shadow onto the grid.
sphere part  0.06  0.02  0.09   0.05

# Measurement grid across the whole work surface, 1 mm above it.
grid -0.3 -0.3 0.001    0.6 0 0    0 0.6 0    64 64

camera 0 -0.72 0.30    0 0 0.06    42 480 360
